# Copy to supabase/functions/.env for the local stack, or write it with `npm run functions:env`,
# which points it at the e2e mock Claude server. Production values are Supabase function secrets
# (ARCHITECTURE.md section 12, docs/go-live.md). SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are provided by the runtime and are not set here; submit-document reads
# only those three.

# process-queue: both required, with no default, so a missing value fails at startup instead of
# reaching the real API. Locally and in CI: a dummy key and the mock server's URL.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# process-queue, optional: overrides app_config.model for local runs and the eval only. Never set
# in production, where app_config.model decides.
CLAUDE_MODEL=

# process-queue and purge-files check it; pg_cron sends it, reading the same value from Vault
CRON_SECRET=
