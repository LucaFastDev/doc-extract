# Copy to supabase/functions/.env for the local stack. Production values are Supabase function
# secrets (ARCHITECTURE.md section 12, docs/go-live.md). SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are provided by the runtime and are not set here.

# process-queue
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=

# process-queue and purge-files check it; pg_cron sends it
CRON_SECRET=
