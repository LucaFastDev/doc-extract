# Copy to .env.local and fill in from `npx supabase status` (local stack values only). Production
# values live only in Vercel (ARCHITECTURE.md section 12, docs/go-live.md).

# Browser and server modules
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The operator's portfolio address, linked from the landing page footer; empty means no link
NEXT_PUBLIC_PORTFOLIO_URL=

# Server only: never NEXT_PUBLIC_, read only in modules that import 'server-only'
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
SITE_URL=

# Access tests only: the local database URL from `npx supabase status`; never set in production
SUPABASE_DB_URL=
